# Base URL of the HireLens backend API.
# Leave EMPTY in local dev — the Vite dev server proxies /api and /media to
# the backend (see vite.config.ts), which avoids CORS and IPv4/IPv6 localhost
# mismatches between the browser and the backend.
#   VITE_API_BASE_URL=
#
# Production (Vercel): your VPS backend public URL, no trailing slash, e.g.
#   VITE_API_BASE_URL=https://api.hirelens.com
#   VITE_API_BASE_URL=http://YOUR_VPS_IP:8000
# NOTE: this URL must be added to the backend's CORS_ORIGINS in backend/.env.
VITE_API_BASE_URL=
