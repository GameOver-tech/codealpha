# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key-here
# Only used for HS256-signed tokens (legacy projects). For ES256 projects
# (newer), verification happens automatically via the JWKS endpoint.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Storage
STORAGE_BUCKET=interview-recordings

# AI Services
WHISPER_API_KEY=sk-your-openai-key-here
CLAUDE_API_KEY=sk-ant-your-claude-key-here

# Mock Mode — set to true to bypass real AI APIs (for demo/testing)
USE_MOCK_AI=false

# Scoring thresholds
SCORE_THRESHOLD_RECOMMENDED=75
SCORE_THRESHOLD_NEEDS_REVIEW=50
