# --- Supabase / Legacy config (kept for compatibility) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Database (Supabase PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- App ---
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_RATE_LIMITING=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_PERIOD_SECONDS=60

# --- Storage ---
STORAGE_BUCKET=interview-recordings
STORAGE_MAX_FILE_MB=200

# --- Deepgram ---
# Required — transcription is ALWAYS performed by Deepgram. There is no
# mock/fallback transcript: if this key is missing or the API fails,
# processing stops with HTTP 500.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TIER=enhanced

# ffmpeg must be installed on the host to extract audio from video files
# (MP4/MOV/AVI/MKV/WebM). Audio-only uploads (MP3/WAV/M4A/FLAC/AAC) do not
# require ffmpeg.

# --- LLM ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
# Chat assistant uses its own model — llama-3.1-8b-instant does not
# support function calling, so the assistant requires a tool-capable model.
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3

# --- Chat assistant ---
CHAT_ENABLED=true
CHAT_MAX_TURNS=6
CHAT_MAX_MESSAGES=40
CHAT_CONTEXT_TTL_DAYS=30
CHAT_ACTIVITY_LOGGING=true
# ⭐ PRIMARY CHATBOT PROVIDER — dedicated Gemini key (fast, best tool calling).
# Falls back to GROQ_API_KEY / OPENROUTER_API_KEY automatically.
GEMINI_CHAT_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
# When true, interview processing is pushed to a Redis queue and the
# worker container (docker compose --profile queue) must be running.
# When false, processing runs as FastAPI BackgroundTasks in-process.
USE_REDIS_QUEUE=false

# --- Scoring thresholds ---
SCORE_THRESHOLD_RECOMMENDED=75
SCORE_THRESHOLD_NEEDS_REVIEW=50
